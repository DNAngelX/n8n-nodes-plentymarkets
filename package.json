{
  "name": "n8n-nodes-plentyone",
  "version": "1.3.6",
  "description": "n8n community node for the PlentyONE (formerly plentymarkets) REST API",
  "homepage": "https://github.com/DNAngelX/n8n-nodes-plentymarkets#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DNAngelX/n8n-nodes-plentymarkets.git"
  },
  "bugs": {
    "url": "https://github.com/DNAngelX/n8n-nodes-plentymarkets/issues"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && mkdir -p dist/nodes/Plentymarkets && cp nodes/Plentymarkets/Plentymarkets.node.json dist/nodes/Plentymarkets/ && cp nodes/Plentymarkets/plentyone.svg dist/nodes/Plentymarkets/ && mkdir -p dist/credentials && cp credentials/plentyone.svg dist/credentials/"
  },
  "n8n": {
    "nodes": [
      "dist/nodes/Plentymarkets/Plentymarkets.node.js"
    ],
    "credentials": [
      "dist/credentials/PlentymarketsApi.credentials.js"
    ]
  },
  "author": {
    "name": "Jan Stoll (DNAngelX)",
    "email": "stolly82@gmail.com",
    "url": "https://github.com/DNAngelX"
  },
  "license": "MIT",
  "keywords": [
    "n8n",
    "plentyone",
    "plentymarkets",
    "n8n-community-node",
    "n8n-community-node-package"
  ],
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "n8n-core": "^1.14.1",
    "n8n-workflow": "^1.82.0",
    "typescript": "^5.3.3"
  }
}
